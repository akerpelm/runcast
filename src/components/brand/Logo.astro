---
type Props = { class?: string };
const { class: className = "" } = Astro.props;
---

<span class:list={["inline-flex items-center gap-2", className]}>
  <svg viewBox="0 0 32 32" class="h-7 w-7 shrink-0" aria-hidden="true">
    <rect width="32" height="32" rx="8" fill="var(--track)" />
    <rect x="4.5" y="8.5" width="23" height="15" rx="7.5" fill="none" stroke="#fff" stroke-width="1.6" />
    <rect x="9" y="13" width="14" height="6" rx="3" fill="#1c5a39" stroke="#fff" stroke-width="1.2" />
  </svg>
  <span class="whitespace-nowrap font-(--font-display) text-[1.2rem] leading-none font-extrabold uppercase tracking-[0.01em] text-foreground sm:text-[1.35rem]">Should I Run</span>
</span>
