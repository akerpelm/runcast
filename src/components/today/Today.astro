---
import { TodayApp } from "./today-app";
import { Skeleton } from "./skeleton";

type Props = { embed?: boolean };
const { embed = false } = Astro.props;
---

<!--
  Client-only: the screen depends on device location, saved preferences and a
  client-side forecast. The wrapper reserves a full viewport so the footer never
  starts on screen and jumps when content replaces the skeleton.
-->
<div class="min-h-dvh">
  <TodayApp client:only="react" embed={embed}>
    <Skeleton slot="fallback" />
  </TodayApp>
</div>
