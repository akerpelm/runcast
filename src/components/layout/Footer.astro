---
type Props = { app?: boolean };
const { app = false } = Astro.props;
---

<footer class:list={["border-t border-hair", app ? "mt-10 pb-28 lg:pb-8" : "mt-12 pb-8"]}>
  <div class:list={["mx-auto px-4 pt-6 sm:px-6", app ? "max-w-6xl" : "max-w-4xl"]}>
    <nav aria-label="Footer" class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[0.95rem] text-muted-foreground">
      <a href="/about/" class="flex min-h-11 items-center rounded-full px-2 hover:text-foreground">How it works</a>
      <a href="/what-to-wear-running/" class="flex min-h-11 items-center rounded-full px-2 hover:text-foreground">What to wear</a>
      <a href="/blog/" class="flex min-h-11 items-center rounded-full px-2 hover:text-foreground">Guides</a>
      <a href="/legal/" class="flex min-h-11 items-center rounded-full px-2 hover:text-foreground">Privacy</a>
      <a href="/?sheet=log" id="footer-log-run" class="flex min-h-11 items-center rounded-full px-2 hover:text-foreground">Log a run</a>
    </nav>
    <p class="mt-3 px-2 text-sm text-muted-foreground">&copy; {new Date().getFullYear()} Should I Run. Weather by Open-Meteo.</p>
  </div>
</footer>

<script>
  document.getElementById("footer-log-run")?.addEventListener("click", (e) => {
    if (window.location.pathname !== "/") return;
    e.preventDefault();
    window.dispatchEvent(new CustomEvent("runcast:open-feedback"));
  });
</script>
