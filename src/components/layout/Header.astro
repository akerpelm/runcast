---
import Logo from "@/components/brand/Logo.astro";
import { pinIcon } from "@/lib/icons";

type Props = { variant?: "app" | "page" | "embed" };
const { variant = "page" } = Astro.props;
const gear = `<svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/></svg>`;
---

<header class="sticky top-0 z-20 w-full border-b border-hair bg-background/90 backdrop-blur-sm" style="padding-top: env(safe-area-inset-top)">
  <div class:list={["mx-auto flex h-16 items-center justify-between gap-3 px-4 sm:px-6", variant === "page" ? "max-w-4xl" : "max-w-6xl"]}>
    {variant === "embed" ? (
      <a href="https://shouldirun.today/" target="_blank" rel="noopener" class="flex min-h-11 items-center"><Logo /><span class="sr-only"> (opens in a new tab)</span></a>
    ) : (
      <a href="/" class="flex min-h-11 items-center rounded-lg"><Logo /></a>
    )}

    {variant === "app" && (
      <div class="flex min-w-0 items-center gap-1">
        <button
          id="location-display"
          type="button"
          data-action="open-sheet"
          data-sheet="location"
          class="press flex min-h-11 min-w-0 items-center gap-1.5 rounded-full border border-hair bg-card px-3 text-[0.95rem] font-semibold hover:bg-muted"
        >
          <span class="shrink-0 text-primary" set:html={pinIcon} />
          <span id="location-text" class="truncate max-w-[8rem] sm:max-w-[16rem]">Locating…</span>
          <span id="location-approx" class="hidden shrink-0 text-sm font-medium text-muted-foreground">approx.</span>
          <span class="sr-only">, change location</span>
        </button>
        <button type="button" data-action="open-sheet" data-sheet="settings" aria-label="Settings: units and appearance" class="press flex h-11 w-11 shrink-0 items-center justify-center rounded-full hover:bg-muted" set:html={gear} />
      </div>
    )}

    {variant === "embed" && (
      <p class="flex min-w-0 items-center gap-1.5 text-[0.95rem] font-semibold"><span class="text-primary" set:html={pinIcon} /><span id="location-text" class="truncate">Brooklyn, NY</span></p>
    )}

    {variant === "page" && (
      <nav aria-label="Site" class="flex items-center gap-1 text-[0.95rem] font-semibold">
        <a href="/" class="flex min-h-11 items-center rounded-full px-3 hover:bg-muted">Today</a>
        <a href="/about/" class="hidden min-h-11 items-center rounded-full px-3 hover:bg-muted sm:flex">How it works</a>
        <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="press flex h-11 w-11 items-center justify-center rounded-full hover:bg-muted">
          <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" /></svg>
          <svg class="block h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" /></svg>
        </button>
      </nav>
    )}
  </div>
</header>
