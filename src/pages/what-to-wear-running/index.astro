---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import TempIndex from "@/components/guide/TempIndex.astro";
import GuideTable from "@/components/guide/GuideTable.astro";
import { getClothingRec } from "@/lib/formulas/clothing";
import { EFFORTS, EFFORT_HEAT_OFFSET, EFFORT_LABELS } from "@/lib/state";
import { GUIDE_BASE, listPhrase } from "@/lib/seo/temperature-guide";

const calm = { windMph: 0, precipitating: false, precipProbability: 0, coldAndPrecip: false, uvIndex: 0, visibilityMeters: 10_000 };
// One representative dress-for temperature inside each clothing tier, warmest first.
const tiers = [
  { range: "Above 75°F", at: 80 },
  { range: "65–75°F", at: 70 },
  { range: "55–64°F", at: 60 },
  { range: "45–54°F", at: 50 },
  { range: "35–44°F", at: 40 },
  { range: "25–34°F", at: 30 },
  { range: "15–24°F", at: 20 },
  { range: "Below 15°F", at: 10 },
].map((t) => ({ ...t, rec: getClothingRec(t.at, calm) }));

const site = Astro.site?.href.replace(/\/$/, "") ?? "";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Should I Run", item: `${site}/` },
    { "@type": "ListItem", position: 2, name: "What to wear running", item: `${site}${GUIDE_BASE}/` },
  ],
};

const tierRows = tiers.map((t) => ({ head: t.range, cells: [t.rec.bottom, t.rec.top, t.rec.accessories.length ? listPhrase(t.rec.accessories) : "None"] }));
const link = "font-semibold text-primary underline decoration-primary/30 underline-offset-2 hover:decoration-primary";
---

<Layout
  title="What to Wear Running: Temperature Guide from 0°F to 90°F | Should I Run"
  description="What to wear running at every temperature from 0°F to 90°F, by effort level. Pick a temperature for the layers, the wind and humidity effects, and the pace cost."
>
  <Header />
  <main class="mx-auto max-w-3xl px-4 py-10 sm:px-6 sm:py-14">
    <h1 class="text-4xl leading-[1.05] tracking-tight text-foreground sm:text-5xl">What to wear running, by temperature</h1>
    <p class="mt-4 max-w-[65ch] text-lg leading-relaxed text-foreground">
      Dress for the temperature you'll feel once you're moving: the feels-like temperature plus 15°F for an easy run, up to 25°F for intervals. Then find that number in the chart.
    </p>
    <p class="mt-3 max-w-[65ch] leading-relaxed text-muted-foreground">
      Pick your temperature for the full breakdown by effort, wind and humidity. Or <a href="/" class={link}>get today's kit for where you are</a>.
    </p>

    <section class="mt-10">
      <h2 class="text-2xl text-foreground">Pick a temperature</h2>
      <TempIndex />
    </section>

    <section class="mt-12">
      <h2 class="text-2xl text-foreground">How much warmer to dress</h2>
      <ul class="mt-4 grid grid-cols-2 border-t border-hair sm:grid-cols-5">
        {EFFORTS.map((e) => (
          <li class="border-b border-hair py-3 pr-4">
            <span class="block text-sm text-muted-foreground">{EFFORT_LABELS[e]}</span>
            <span class="font-(family-name:--font-display) text-2xl font-bold tabular-nums">+{EFFORT_HEAT_OFFSET[e]}°F</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm text-muted-foreground">If you always end up carrying a layer, add another 5°F.</p>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl text-foreground">The clothing chart</h2>
      <p class="mt-2 max-w-[65ch] text-muted-foreground">Find your dress-for temperature, not the forecast.</p>
      <GuideTable caption="Running clothing chart by dress-for temperature" columns={["Dress for", "Bottom", "Top", "Extras"]} rows={tierRows} />
      <p class="mt-3 max-w-[65ch] text-sm text-muted-foreground">
        Wind over 15&nbsp;mph adds a wind-resistant layer, and rain adds a water-resistant one.
        <a href="/blog/what-to-wear-running-by-temperature/" class={link}>Read the full guide</a>.
      </p>
    </section>
  </main>
  <Footer />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Layout>
