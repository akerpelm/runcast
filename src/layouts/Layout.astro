---
import "@/styles/starwind.css";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  ogImage?: string;
  /** Iframe preview on the portfolio hub: no analytics, no service worker. */
  embed?: boolean;
}

const {
  title,
  description = "Free daily running briefing with weather-adjusted pace, clothing recommendations, ice warnings, and optimal run timing. No account needed.",
  noindex = false,
  ogImage,
  embed = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || Astro.url.origin);
const ogImageURL = ogImage
  ? new URL(ogImage, Astro.site || Astro.url.origin).href
  : new URL("/og.svg", Astro.site || Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f3f1eb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1110" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Should I Run" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />

    {!embed && (
      /* ?embed=1 is an alias for /embed/; pages are static, so redirect client-side before paint. */
      <script is:inline>
        if (new URLSearchParams(location.search).get("embed") === "1") location.replace("/embed/");
      </script>
    )}

    <!-- Theme: prevent flash by setting class before paint -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem("runcast-theme");
        if (
          stored === "dark" ||
          (!stored && window.matchMedia("(prefers-color-scheme: dark)").matches)
        ) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <!-- Preconnect to critical API origins -->
    <link rel="preconnect" href="https://api.open-meteo.com" />
    <link rel="preconnect" href="https://air-quality-api.open-meteo.com" />

    <!-- Self-hosted fonts via Astro Fonts API -->
    <Font cssVariable="--font-display" preload={[{ weight: "800" }]} />
    <Font cssVariable="--font-body" preload={[{ weight: "400" }, { weight: "600" }]} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Should I Run" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:alt" content="Should I Run — Your daily running briefing" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content="Should I Run — Your daily running briefing" />

    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL.href} />

    {!embed && (
      <>
        <!-- Privacy-friendly analytics by Plausible -->
        <script async src="https://plausible.io/js/pa-DjNsHBzg9pQdRPNvM3OdN.js"></script>
        <script is:inline>
          window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
          plausible.init();
        </script>
      </>
    )}

    <title>{title}</title>

    {import.meta.env.DEV && (
      /* Dev only: the sheet host is imported lazily rather than rendered as an
         island, so Astro never injects @vitejs/plugin-react's refresh preamble. */
      <script is:inline type="module">
        import RefreshRuntime from "/@react-refresh";
        RefreshRuntime.injectIntoGlobalHook(window);
        window.$RefreshReg$ = () => {};
        window.$RefreshSig$ = () => (type) => type;
        window.__vite_plugin_react_preamble_installed__ = true;
      </script>
    )}

    <!-- JSON-LD: WebApplication -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        name: "Should I Run",
        alternateName: "Should I Run Running Weather",
        description:
          "Free daily running briefing with weather-adjusted pace, clothing recommendations, surface warnings, and optimal run timing.",
        url: (Astro.site || Astro.url.origin).toString(),
        applicationCategory: "SportsApplication",
        operatingSystem: "Any",
        browserRequirements: "Requires JavaScript.",
        offers: {
          "@type": "Offer",
          price: "0",
          priceCurrency: "USD",
        },
        featureList: [
          "Weather-adjusted pace calculator",
          "Running clothing recommendations",
          "Ice and surface risk detection",
          "Best run window scoring",
          "Air quality index for runners",
          "Sunrise and sunset run planning",
          "Run type suggestions",
          "Shoe rotation tracking",
        ],
        screenshot: ogImageURL,
      })}
    />

    <!-- JSON-LD: Organization -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Organization",
        name: "Should I Run",
        url: (Astro.site || Astro.url.origin).toString(),
        logo: new URL("/favicon.svg", Astro.site || Astro.url.origin).href,
        sameAs: [],
      })}
    />
  </head>
  <body class="min-h-dvh bg-background text-foreground antialiased">
    <slot />

    {!embed && (
      <script is:inline>
        if ("serviceWorker" in navigator) {
          navigator.serviceWorker.register("/sw.js");
        }
      </script>
    )}

    <!-- Theme toggle logic -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const toggle = document.getElementById("theme-toggle");
        if (!toggle) return;

        toggle.addEventListener("click", () => {
          const isDark = document.documentElement.classList.toggle("dark");
          localStorage.setItem("runcast-theme", isDark ? "dark" : "light");
        });
      });
    </script>
  </body>
</html>
